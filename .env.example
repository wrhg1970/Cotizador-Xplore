# Copia a .env. Nunca subas .env al repositorio.

# PostgreSQL local (infra/docker-compose.yml)
POSTGRES_DB=ee_quotes
POSTGRES_USER=ee_app
POSTGRES_PASSWORD=cambia_esta_clave_local
DATABASE_URL=postgresql://ee_app:cambia_esta_clave_local@localhost:5432/ee_quotes

# API
NODE_ENV=development
API_PORT=4000
# URL pública de la API; el redirect de Google es ${API_PUBLIC_URL}/api/v1/auth/google/callback
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Google OIDC. Sin GOOGLE_CLIENT_ID/SECRET el login responde 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominios de Google Workspace permitidos, separados por coma.
# Comma-separated; each must be a Google Workspace domain (the login checks the hd claim).
ALLOWED_GOOGLE_DOMAINS=estudiantesembajadores.com
# Mínimo 32 caracteres: openssl rand -hex 32
SESSION_SECRET=

# Primer administrador (pnpm --filter @ee/db seed)
SEED_OFFICE_CODE=
SEED_OFFICE_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Avisos por correo (opcional; apagados si falta host, usuario o contraseña)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# WeTravel Partner API (opcional; sin llave no se crean ligas de pago). Sandbox: https://api.demo.wetravel.to/v3
WETRAVEL_API_KEY=
WETRAVEL_API_URL=https://api.wetravel.com/v3
# Web Push (opcional): llave P-256 en PEM, por ejemplo `openssl ecparam -name prime256v1 -genkey -noout`
VAPID_PRIVATE_KEY=
