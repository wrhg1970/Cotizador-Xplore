# Copia a .env. Nunca subas .env al repositorio.

# PostgreSQL local (infra/docker-compose.yml)
POSTGRES_DB=ee_quotes
POSTGRES_USER=ee_app
POSTGRES_PASSWORD=cambia_esta_clave_local
DATABASE_URL=postgresql://ee_app:cambia_esta_clave_local@localhost:5432/ee_quotes

# API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Google OIDC (Sprint 1). Dominios permitidos separados por coma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAINS=
SESSION_SECRET=
