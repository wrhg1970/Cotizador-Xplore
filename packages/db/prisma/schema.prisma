generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// PRD.md §5
enum Role {
  ADVISOR
  QUOTER
  APPROVER
  OFFICE_ADMIN
  SYSTEM_ADMIN
  AUDITOR
}

model User {
  id          String           @id @default(uuid()) @db.Uuid
  email       String           @unique
  googleSub   String?          @unique @map("google_sub")
  name        String
  status      UserStatus       @default(INVITED)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  officeRoles UserOfficeRole[]
  sessions    Session[]
  requested   TravelRequest[]  @relation("requester")
  assigned    TravelRequest[]  @relation("assignee")
  comments    RequestComment[]

  @@map("users")
}

model Office {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoles UserOfficeRole[]
  requests  TravelRequest[]

  @@map("offices")
}

model UserOfficeRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Restrict)

  @@unique([userId, officeId, role])
  @@index([officeId])
  @@map("user_office_roles")
}

/// Append-only: a DB trigger rejects UPDATE/DELETE (see migration).
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  correlationId String   @map("correlation_id")
  diff          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Server-side session; the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Request lifecycle (analysis doc): quote-version states live on QuoteVersion later.
enum RequestStatus {
  DRAFT
  SUBMITTED
  QUOTING
  SENT
  WON
  LOST
  CANCELLED
}

enum BudgetBasis {
  TOTAL
  PER_PARTICIPANT
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

/// Checks (dates, counts, budget all-or-nothing) are enforced in the migration SQL too.
model TravelRequest {
  id             String           @id @default(uuid()) @db.Uuid
  folio          String           @unique
  officeId       String           @map("office_id") @db.Uuid
  requesterId    String           @map("requester_id") @db.Uuid
  assigneeId     String?          @map("assignee_id") @db.Uuid
  status         RequestStatus    @default(DRAFT)
  groupName      String           @map("group_name")
  clientName     String?          @map("client_name")
  program        String?
  city           String
  countryCode    String           @map("country_code") @db.Char(2)
  departureDate  DateTime         @map("departure_date") @db.Date
  returnDate     DateTime         @map("return_date") @db.Date
  participants   Int
  chaperones     Int              @default(0)
  staff          Int              @default(0)
  budgetAmount   Decimal?         @map("budget_amount") @db.Decimal(18, 4)
  budgetCurrency String?          @map("budget_currency") @db.Char(3)
  budgetBasis    BudgetBasis?     @map("budget_basis")
  requirements   String?
  priority       Priority         @default(NORMAL)
  dueDate        DateTime?        @map("due_date") @db.Date
  cancelReason   String?          @map("cancel_reason")
  /// Optimistic concurrency (US-142).
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  office         Office           @relation(fields: [officeId], references: [id], onDelete: Restrict)
  requester      User             @relation("requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  comments       RequestComment[]

  @@index([officeId, status, createdAt])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@map("travel_requests")
}

model RequestComment {
  id        String        @id @default(uuid()) @db.Uuid
  requestId String        @map("request_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  body      String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  request   TravelRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("request_comments")
}
