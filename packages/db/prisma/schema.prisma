generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// PRD.md §5
enum Role {
  ADVISOR
  QUOTER
  APPROVER
  OFFICE_ADMIN
  SYSTEM_ADMIN
  AUDITOR
}

/// Configurable permissions per role (contracts RolePolicyInput); SYSTEM_ADMIN has no row and is always global.
model RolePolicy {
  role               Role     @id
  allOffices         Boolean  @default(false) @map("all_offices")
  canView            Boolean  @default(true) @map("can_view")
  canCreate          Boolean  @default(false) @map("can_create")
  canEdit            Boolean  @default(false) @map("can_edit")
  canDelete          Boolean  @default(false) @map("can_delete")
  viewInternalCosts  Boolean  @default(false) @map("view_internal_costs")
  exportInternalXlsx Boolean  @default(false) @map("export_internal_xlsx")
  approvalLimitMxn   Decimal? @map("approval_limit_mxn") @db.Decimal(14, 2)
  updatedById        String?  @map("updated_by_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("role_policies")
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  email          String              @unique
  googleSub      String?             @unique @map("google_sub")
  name           String
  status         UserStatus          @default(INVITED)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  officeRoles    UserOfficeRole[]
  sessions       Session[]
  requested      TravelRequest[]     @relation("requester")
  assigned       TravelRequest[]     @relation("assignee")
  comments       RequestComment[]
  scenarios      QuoteScenario[]
  versions       QuoteVersion[]
  templates      QuoteTemplate[]
  fxRates        QuoteFxRate[]
  officialRates  OfficialRate[]
  settings       AppSetting[]
  reviews        QuoteReview[]
  deliveries     ProposalDelivery[]
  rolePolicies   RolePolicy[]
  attachments    RequestAttachment[]
  memberships    RequestMember[]
  proposalShares ProposalShare[]

  @@map("users")
}

model Office {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoles UserOfficeRole[]
  requests  TravelRequest[]
  templates QuoteTemplate[]

  @@map("offices")
}

model UserOfficeRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Restrict)

  @@unique([userId, officeId, role])
  @@index([officeId])
  @@map("user_office_roles")
}

/// Append-only: a DB trigger rejects UPDATE/DELETE (see migration).
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  correlationId String   @map("correlation_id")
  diff          Json?
  /// Set by a DB trigger from the entity (request, version, template, office, role grant); null = global.
  officeId      String?  @map("office_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([officeId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Server-side session; the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Request lifecycle (analysis doc): quote-version states live on QuoteVersion later.
enum RequestStatus {
  DRAFT
  SUBMITTED
  QUOTING
  SENT
  WON
  LOST
  CANCELLED
}

enum BudgetBasis {
  TOTAL
  PER_PARTICIPANT
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

/// Checks (dates, counts, budget all-or-nothing) are enforced in the migration SQL too.
model TravelRequest {
  id             String              @id @default(uuid()) @db.Uuid
  folio          String              @unique
  officeId       String              @map("office_id") @db.Uuid
  requesterId    String              @map("requester_id") @db.Uuid
  assigneeId     String?             @map("assignee_id") @db.Uuid
  status         RequestStatus       @default(DRAFT)
  groupName      String              @map("group_name")
  clientName     String?             @map("client_name")
  program        String?
  city           String
  countryCode    String              @map("country_code") @db.Char(2)
  departureDate  DateTime            @map("departure_date") @db.Date
  returnDate     DateTime            @map("return_date") @db.Date
  participants   Int
  chaperones     Int                 @default(0)
  staff          Int                 @default(0)
  budgetAmount   Decimal?            @map("budget_amount") @db.Decimal(18, 4)
  budgetCurrency String?             @map("budget_currency") @db.Char(3)
  budgetBasis    BudgetBasis?        @map("budget_basis")
  requirements   String?
  /// Structured trip details (contracts TripSpecs).
  specifications Json?
  priority       Priority            @default(NORMAL)
  dueDate        DateTime?           @map("due_date") @db.Date
  cancelReason   String?             @map("cancel_reason")
  /// Sent version the client accepted; unique, so a request has one winner and a version wins only once (PRD F-06).
  wonVersionId   String?             @unique @map("won_version_id") @db.Uuid
  /// Why the client declined (LOST); required by a CHECK in the migration.
  lostReason     String?             @map("lost_reason")
  /// When the outcome (WON/LOST) was recorded.
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(3)
  /// WeTravel payment link created from the winning version (uuid and checkout URL from their API).
  wetravelLinkId String?             @unique @map("wetravel_link_id")
  wetravelUrl    String?             @map("wetravel_url")
  /// Optimistic concurrency (US-142).
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  office         Office              @relation(fields: [officeId], references: [id], onDelete: Restrict)
  requester      User                @relation("requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee       User?               @relation("assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  wonVersion     QuoteVersion?       @relation("wonVersion", fields: [wonVersionId], references: [id], onDelete: Restrict)
  comments       RequestComment[]
  attachments    RequestAttachment[]
  members        RequestMember[]
  scenarios      QuoteScenario[]

  @@index([officeId, status, createdAt])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@map("travel_requests")
}

model RequestComment {
  id        String        @id @default(uuid()) @db.Uuid
  requestId String        @map("request_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  body      String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  request   TravelRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("request_comments")
}

/// Quote version lifecycle; approval/sending transitions arrive in Sprint 4.
enum QuoteVersionStatus {
  DRAFT
  IN_REVIEW
  RETURNED
  APPROVED
  SENT
  SUPERSEDED
}

/// FORMULAS.md line categories; how each multiplies is defined by the formula set, not here.
/// Pilot categories from Finance's sheet; chaperones = client's, staff = EE's.
enum LineCategory {
  PER_PARTICIPANT
  PER_CHAPERONE
  PER_STAFF
  PER_GROUP
  CONTINGENCY
}

model QuoteScenario {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  name        String
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  request     TravelRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    QuoteVersion[]

  @@index([requestId])
  @@map("quote_scenarios")
}

/// A version is the unit that gets calculated, approved and sent; group sizes live here so siblings never interfere (US-031).
model QuoteVersion {
  id                   String             @id @default(uuid()) @db.Uuid
  scenarioId           String             @map("scenario_id") @db.Uuid
  number               Int
  status               QuoteVersionStatus @default(DRAFT)
  saleCurrency         String             @map("sale_currency") @db.Char(3)
  /// Margin over sale price (Finance's "% Comisión"): price = cost / (1 - rate).
  targetMarginRate     Decimal            @default(0) @map("target_margin_rate") @db.Decimal(7, 6)
  /// MXN per 1 sale currency, only for the approximate peso figures shown to the client.
  mxnRate              Decimal?           @map("mxn_rate") @db.Decimal(20, 10)
  participants         Int
  chaperones           Int
  staff                Int
  validUntil           DateTime?          @map("valid_until") @db.Date
  assumptions          String?
  /// Registration + installments config (contracts PaymentPlanInput); the schedule is computed, not stored.
  paymentPlan          Json?              @map("payment_plan")
  /// "1 lugar liberado por cada N estudiantes"; informative only, never changes the price (confirmed 2026-10-27).
  studentsPerFreePlace Int?               @map("students_per_free_place")
  freePlaceBenefit     FreePlaceBenefit?  @map("free_place_benefit")
  /// Day-by-day plan shown in the proposal (contracts ItineraryDay[]).
  itinerary            Json?
  /// "No incluye" lines for the proposal.
  exclusions           String[]           @default([])
  /// Destination photo on the proposal: an image attachment of the same request.
  coverAttachmentId    String?            @map("cover_attachment_id") @db.Uuid
  coverAttachment      RequestAttachment? @relation(fields: [coverAttachmentId], references: [id], onDelete: Restrict)
  /// Optimistic concurrency token for edits.
  rowVersion           Int                @default(1) @map("row_version")
  createdById          String             @map("created_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  scenario             QuoteScenario      @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy            User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines                QuoteLine[]
  fxRates              QuoteFxRate[]
  reviews              QuoteReview[]
  deliveries           ProposalDelivery[]
  wonFor               TravelRequest?     @relation("wonVersion")
  shares               ProposalShare[]

  @@unique([scenarioId, number])
  @@map("quote_versions")
}

enum FreePlaceBenefit {
  CHAPERONE
  STUDENT
}

model QuoteLine {
  id           String       @id @default(uuid()) @db.Uuid
  versionId    String       @map("version_id") @db.Uuid
  position     Int
  category     LineCategory
  description  String
  quantity     Decimal      @db.Decimal(18, 4)
  unitCost     Decimal      @map("unit_cost") @db.Decimal(18, 4)
  currency     String       @db.Char(3)
  /// Never shown on the client PDF (US-035).
  internalOnly Boolean      @default(false) @map("internal_only")
  costSource   String?      @map("cost_source")
  version      QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, position])
  @@map("quote_lines")
}

/// FX rate frozen per version with date, source and who captured it (CLAUDE.md, US-055).
/// Official EE exchange rates kept by Finance; append-only, the latest rate per pair is the current one.
model OfficialRate {
  id           String   @id @default(uuid()) @db.Uuid
  fromCurrency String   @map("from_currency") @db.Char(3)
  toCurrency   String   @map("to_currency") @db.Char(3)
  /// Units of toCurrency per 1 fromCurrency.
  rate         Decimal  @db.Decimal(20, 10)
  rateDate     DateTime @map("rate_date") @db.Date
  source       String
  /// Null when a scheduled process (Banxico) captured it.
  capturedById String?  @map("captured_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  capturedBy   User?    @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([fromCurrency, toCurrency, createdAt])
  @@map("official_rates")
}

model QuoteFxRate {
  id           String       @id @default(uuid()) @db.Uuid
  versionId    String       @map("version_id") @db.Uuid
  fromCurrency String       @map("from_currency") @db.Char(3)
  toCurrency   String       @map("to_currency") @db.Char(3)
  /// Units of toCurrency per 1 fromCurrency.
  rate         Decimal      @db.Decimal(20, 10)
  rateDate     DateTime     @map("rate_date") @db.Date
  source       String
  capturedById String       @map("captured_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  version      QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  capturedBy   User         @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@unique([versionId, fromCurrency])
  @@map("quote_fx_rates")
}

enum ReviewDecision {
  APPROVED
  RETURNED
}

/// Approval record (US-071..076): append-only, tied to the exact calculation it approved.
model QuoteReview {
  id              String         @id @default(uuid()) @db.Uuid
  versionId       String         @map("version_id") @db.Uuid
  reviewerId      String         @map("reviewer_id") @db.Uuid
  decision        ReviewDecision
  comment         String?
  calculationHash String         @map("calculation_hash")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  version         QuoteVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([versionId, createdAt])
  @@map("quote_reviews")
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  IN_PERSON
  OTHER
}

/// Manual send of an approved version to the client (DATABASE.md ProposalDelivery).
model ProposalDelivery {
  id         String          @id @default(uuid()) @db.Uuid
  versionId  String          @map("version_id") @db.Uuid
  sentById   String          @map("sent_by_id") @db.Uuid
  recipients String
  channel    DeliveryChannel
  sentOn     DateTime        @map("sent_on") @db.Date
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  version    QuoteVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  sentBy     User            @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@map("proposal_deliveries")
}

/// Catalog of quote concepts ("rubros") that admins maintain; new scenarios start with the base ones (EE sheet).
model ConceptTemplate {
  id           String       @id @default(uuid()) @db.Uuid
  label        String
  category     LineCategory
  internalOnly Boolean      @default(false) @map("internal_only")
  /// Pre-filled in every new scenario.
  isBase       Boolean      @default(false) @map("is_base")
  /// Quantity starts as the trip's days (return − departure + 1), e.g. allowances.
  perTripDay   Boolean      @default(false) @map("per_trip_day")
  position     Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([category, label])
  @@map("concept_templates")
}

/// Reusable starting point for a scenario (lines, margin, proposal content), shared within one office.
model QuoteTemplate {
  id                   String            @id @default(uuid()) @db.Uuid
  officeId             String            @map("office_id") @db.Uuid
  name                 String
  saleCurrency         String            @map("sale_currency") @db.Char(3)
  targetMarginRate     Decimal           @map("target_margin_rate") @db.Decimal(7, 6)
  /// Snapshot of the source version's lines (contracts QuoteLineInput[]).
  lines                Json
  studentsPerFreePlace Int?              @map("students_per_free_place")
  freePlaceBenefit     FreePlaceBenefit? @map("free_place_benefit")
  itinerary            Json?
  exclusions           String[]          @default([])
  assumptions          String?
  active               Boolean           @default(true)
  createdById          String            @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  office               Office            @relation(fields: [officeId], references: [id], onDelete: Restrict)
  createdBy            User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([officeId, active])
  @@map("quote_templates")
}

/// File attached to a request (school letter, supplier quote). Bytes live in Postgres.
/// shortcut: bytea storage capped at 3 MB × 20 files per request, fine for the pilot; move to Cloud Storage if volume grows.
model RequestAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  requestId    String         @map("request_id") @db.Uuid
  fileName     String         @map("file_name")
  /// Sniffed from the bytes against an allowlist, never taken from the client.
  mimeType     String         @map("mime_type")
  size         Int
  content      Bytes
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  request      TravelRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  coverOf      QuoteVersion[]

  @@index([requestId, createdAt])
  @@map("request_attachments")
}

enum MemberKind {
  COMMERCIAL
  SUPPORT
}

/// People working a request besides requester and assignee (V2 "ejecutivo comercial" and apoyo).
model RequestMember {
  requestId String        @map("request_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      MemberKind
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  request   TravelRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([requestId, userId])
  @@index([userId])
  @@map("request_members")
}

/// Link the school opens without an account (V2 "portal de la propuesta"): only the token's SHA-256 is stored.
model ProposalShare {
  id          String       @id @default(uuid()) @db.Uuid
  versionId   String       @map("version_id") @db.Uuid
  tokenHash   String       @unique @map("token_hash")
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  viewCount   Int          @default(0) @map("view_count")
  lastViewAt  DateTime?    @map("last_view_at") @db.Timestamptz(3)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  version     QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@map("proposal_shares")
}

/// Small admin-editable settings (contracts AlertSettings, …) keyed by name; the value is validated in the API.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("app_settings")
}
